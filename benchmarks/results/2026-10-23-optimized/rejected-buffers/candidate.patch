 #[cfg(test)]
 mod tests {
     use super::*;
     use crate::core::desired::DesiredWindow;
     use crate::types::{Client, ViewId, WinFlags};
 
+    // window-trace deliberately formats and allocates a log line per reconcile.
+    // Measure the shipped build; the traced build tests geometry separately.
+    #[cfg(not(feature = "window-trace"))]
+    #[test]
+    fn warmed_reconciliation_allocates_nothing_while_geometry_changes() {
+        use crate::core::framebench::CountAllocs;
+        for count in [1, 10, 50, 256] {
+            let state = State::new();
+            let mut placements: Vec<_> = (1..=count)
+                .map(|win| (win, Rect::new(0, 0, 640, 480), 2))
+                .collect();
+            let mut desired = DesiredState::default();
+            let mut applied = AppliedState::default();
+            let mut scratch = ReconcileScratch::default();
+            desired.update_from_placements(&placements);
+            reconcile_into(&desired, &state, &mut applied, &mut scratch);
+            let counter = CountAllocs::start();
+            for x in 1..=100 {
+                for (_, rect, _) in &mut placements {
+                    rect.x = x;
+                }
+                desired.update_from_placements(&placements);
+                reconcile_into(&desired, &state, &mut applied, &mut scratch);
+                assert_eq!(scratch.effects.len(), count as usize);
+            }
+            let allocations = counter.finish();
+            assert_eq!(allocations, 0, "population {count}");
+        }
+    }
+
+    #[test]
+    fn reused_buffers_forget_previous_monitors_and_keep_last_duplicate() {
+        let state = State::new();
+        let mut applied = AppliedState::default();
+        let mut scratch = ReconcileScratch::default();
+        let mut desired = DesiredState::default();
+        let a = Rect::new(1, 2, 640, 480);
+        let b = Rect::new(20, 30, 800, 600);
+        desired.update_from_placements(&[(1, a, 2), (2, a, 2), (1, b, 0)]);
+        reconcile_into(&desired, &state, &mut applied, &mut scratch);
+        let windows: Vec<_> = scratch
+            .effects
+            .iter()
+            .map(|e| match e {
+                GeometryEffect::Configure { win, .. } => *win,
+            })
+            .collect();
+        assert_eq!(windows, [2, 1]);
+        assert_eq!(applied.windows[&1].rect, b);
+        assert_eq!(applied.windows[&1].border_w, 0);
+        desired.update_from_placements(&[(1, a, 2)]);
+        reconcile_into(&desired, &state, &mut applied, &mut scratch);
+        assert_eq!(scratch.effects.len(), 1);
+        assert_eq!(applied.windows[&1].rect, a);
+        desired.update_from_placements(&[]);
+        reconcile_into(&desired, &state, &mut applied, &mut scratch);
+        assert!(scratch.effects.is_empty());
+        assert!(scratch.last_index.is_empty());
+        assert!(desired.windows.is_empty());
+        desired.update_from_placements(&[(1, a, 2)]);
+        reconcile_into(&desired, &state, &mut applied, &mut scratch);
+        assert!(
+            scratch.effects.is_empty(),
+            "identical geometry must stay a no-op"
+        );
+    }
