/target

# compiled test-client binaries (built from tests/*.c on demand)
/tests/winmove
/tests/damager
/tests/mgdwin
/tests/pxsample
/tests/staticwin
/tests/dockstrut
/tests/fsclient
/tests/hostile
/tests/keyboard-probe
/tests/realwin
/tests/setmon
/tests/stacking-probe
/tests/stress
/tests/xtest-stress
/tests/xtest_input

# run artifacts from the Xephyr and Xvfb harnesses
/tests/*.log
__pycache__/

# `tests/xephyr-real-fullscreen.sh` `mkdir -p logs` at the repository root and
# writes the run summary there. Nothing reads it back, so a run must not leave the
# tree dirty.
/logs/

# `cargo mutants` working directory: generated output, never source. The
# trailing wildcard covers the `.old` suffix the tool appends when it rotates an
# existing run out of the way, which otherwise reappears as an untracked
# directory after every second mutation session.
/mutants.out*/
